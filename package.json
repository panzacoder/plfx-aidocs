{
  "name": "v1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel --ui=tui",
    "dev:web": "turbo dev --filter=@v1/web",
    "dev:jobs": "turbo jobs --filter=@v1/jobs",
    "dev:app": "turbo dev --filter=@v1/app",
    "start:web": "turbo start --filter=@v1/web",
    "start:app": "turbo start --filter=@v1/app",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui",
    "test:e2e": "turbo run test:e2e",
    "format": "biome format --write .",
    "lint": "turbo lint && bun lint:repo",
    "lint:repo": "pnpm dlx sherif@latest",
    "lint:repo:fix": "pnpm dlx sherif@latest --fix",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.12",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/persistent-text-streaming": "^0.2.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "@vitejs/plugin-react": "^4.3.3",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.1",
    "ora": "^5.4.1",
    "playwright": "^1.48.2",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "turbo": "2.4.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8",
    "zod": "^4.1.8"
  },
  "packageManager": "pnpm@9.15.4"
}
