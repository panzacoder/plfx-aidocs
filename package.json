{
  "name": "v1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel --ui=tui",
    "dev:web": "turbo dev --filter=@v1/web",
    "dev:jobs": "turbo jobs --filter=@v1/jobs",
    "dev:app": "turbo dev --filter=@v1/app",
    "start:web": "turbo start --filter=@v1/web",
    "start:app": "turbo start --filter=@v1/app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "lint": "turbo lint && pnpm lint:repo",
    "lint:repo": "pnpm dlx sherif@latest",
    "lint:repo:fix": "pnpm dlx sherif@latest --fix",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/react": "^18",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "ora": "^5.4.1",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "turbo": "2.4.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.1",
    "@vitest/coverage-v8": "^3.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@9.15.4"
}
